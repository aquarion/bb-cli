{
    "name": "aquarion/bb-cli",
    "description": "Bitbucket Rest API CLI written in pure PHP",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5",
        "rector/rector": "^2.8"
    },
    "autoload": {
        "psr-4": {
            "BBCli\\BBCli\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "BBCli\\BBCli\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit",
        "rector": "rector process --dry-run"
    }
}
